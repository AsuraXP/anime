#!/usr/bin/env bash
# research/bin/sync — run at the START of every turn. Read-only w.r.t. your own files. Safe anytime.
#
#   bash research/bin/sync
#
# Fetches the other agent's branch and mirrors what they wrote into .research-sync/ (gitignored).
# It never writes into research/ itself, so a stray `git add` can never commit the other agent's
# files onto your branch.
#
# Peer-branch resolution order (first hit wins):
#   1. $OTHER_BRANCH env var
#   2. OTHER_BRANCH in .research-local
#   3. auto-detect: the only `arena/*` branch on origin that is not ours
set -uo pipefail

# An explicit environment override must beat the local config file, otherwise the config can never be
# corrected, tested, or pointed at a throwaway branch. Capture env, source the file, then re-apply.
ENV_SELF=${SELF:-}; ENV_SELF_BRANCH=${SELF_BRANCH:-}; ENV_OTHER_BRANCH=${OTHER_BRANCH:-}
[ -f .research-local ] && . ./.research-local
[ -n "$ENV_SELF" ] && SELF=$ENV_SELF
[ -n "$ENV_SELF_BRANCH" ] && SELF_BRANCH=$ENV_SELF_BRANCH
[ -n "$ENV_OTHER_BRANCH" ] && OTHER_BRANCH=$ENV_OTHER_BRANCH
SELF=${SELF:-agent-a}
SELF_BRANCH=${SELF_BRANCH:-$(git rev-parse --abbrev-ref HEAD)}
SELF_SHORT=${SELF#agent-}
OTHER=$([ "$SELF_SHORT" = "a" ] && echo agent-b || echo agent-a)
OTHER_SHORT=${OTHER#agent-}

resolve_other_branch() {
  if [ -n "${OTHER_BRANCH:-}" ]; then echo "$OTHER_BRANCH"; return; fi
  git fetch --quiet origin 'refs/heads/*:refs/remotes/origin/*' 2>/dev/null
  local SELFLOG="research/log/status-agent-${SELF_SHORT}.md"
  local cands=""
  # An `arena/*` branch is a peer candidate if it is not ours AND it carries the research tree.
  # (Arena allocates arena/<hash> per session, so a genuinely unrelated arena branch may exist.)
  for b in $(git for-each-ref --format='%(refname:short)' 'refs/remotes/origin/arena/*' 2>/dev/null \
             | sed 's#^origin/##'); do
    [ "$b" = "$SELF_BRANCH" ] && continue
    if git cat-file -e "origin/$b:research/CHARTER.md" 2>/dev/null; then cands="$cands $b"; fi
  done
  cands=$(printf '%s\n' $cands)
  local n; n=$(printf '%s\n' "$cands" | grep -c . || true)

  if [ "$n" = "1" ]; then echo "$cands"; return; fi

  # Ambiguous or empty: if we already seeded the research tree from someone, follow ITS status file.
  if [ -f "$SELFLOG" ]; then
    for b in $(git for-each-ref --format='%(refname:short)' 'refs/remotes/origin/arena/*' 2>/dev/null \
               | sed 's#^origin/##'); do
      [ "$b" = "$SELF_BRANCH" ] && continue
      if [ "$(git show "origin/$b:$SELFLOG" 2>/dev/null | head -3)" = "$(head -3 "$SELFLOG")" ]; then
        echo "$b"; return
      fi
    done
  fi

  if [ "$n" -gt 1 ] 2>/dev/null; then echo "AMBIGUOUS:$cands"; else echo ""; fi
}

OTHER_BRANCH=$(resolve_other_branch)
case "$OTHER_BRANCH" in
  AMBIGUOUS:*)
    echo "?? several candidate peer branches:${OTHER_BRANCH#AMBIGUOUS:}"
    echo "   pick one:  echo 'OTHER_BRANCH=<branch>' >> .research-local"
    exit 1 ;;
  "")
    echo "!! no peer branch found on origin (no arena/* branch other than '$SELF_BRANCH')."
    echo "   If the other agent has not pushed yet, wait a turn."
    echo "   If their branch has a different name, set it:  echo 'OTHER_BRANCH=<branch>' >> .research-local"
    exit 1 ;;
esac

SYNC=.research-sync
OTHER_INBOX="research/msg/inbox-$OTHER.md"
OTHER_STATUS="research/log/status-agent-$OTHER_SHORT.md"

echo "== $SELF ($SELF_BRANCH) reading $OTHER ($OTHER_BRANCH) =="
git fetch --quiet --force origin "refs/heads/$OTHER_BRANCH:refs/remotes/origin/$OTHER_BRANCH" 2>/dev/null \
  || { echo "!! cannot fetch '$OTHER_BRANCH'"; exit 1; }

mkdir -p "$SYNC/spec"

if git show "origin/$OTHER_BRANCH:$OTHER_INBOX" > "$SYNC/inbox-$OTHER.md" 2>/dev/null; then
  echo "   read $OTHER_INBOX"
else
  rm -f "$SYNC/inbox-$OTHER.md"; echo "   (no messages from $OTHER yet)"
fi

if git show "origin/$OTHER_BRANCH:$OTHER_STATUS" > "$SYNC/status-$OTHER.md" 2>/dev/null; then
  echo "   read $OTHER_STATUS"
else
  rm -f "$SYNC/status-$OTHER.md"; echo "   (no status from $OTHER yet)"
fi

CHANGED=""
for f in research/CHARTER.md research/PROTOCOL.md research/README.md research/BOOTSTRAP.md; do
  if git show "origin/$OTHER_BRANCH:$f" > "$SYNC/spec/$(basename "$f")" 2>/dev/null; then
    if [ -f "$f" ] && ! diff -q "$f" "$SYNC/spec/$(basename "$f")" >/dev/null 2>&1; then
      CHANGED="$CHANGED $f"
    fi
  fi
done

echo
echo "---- $OTHER's status ----"
cat "$SYNC/status-$OTHER.md" 2>/dev/null || echo "(none yet)"
echo
echo "---- messages FROM $OTHER ----"
if [ -f "$SYNC/inbox-$OTHER.md" ]; then
  grep -E '^## MSG-|^\*\*' "$SYNC/inbox-$OTHER.md" 2>/dev/null || echo "(none)"
  echo
  echo "   full text: $SYNC/inbox-$OTHER.md  -- read it before replying"
else
  echo "(none yet)"
fi

if [ -n "$CHANGED" ]; then
  echo
  echo "---- SPEC DIFFERS from $OTHER_BRANCH ----"
  for f in $CHANGED; do
    echo "### $f"
    diff -u "$f" "$SYNC/spec/$(basename "$f")" | head -40
  done
  echo "   Adopt only if an AMEND was ratified:  cp $SYNC/spec/<file> research/<file>"
fi

if [ "$SELF" = "agent-a" ]; then SENDARG=""; else SENDARG="b"; fi
echo
echo "Next: bash research/bin/send $SENDARG \"subject\" body.md"
