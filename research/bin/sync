#!/usr/bin/env bash
# research/bin/sync — run at the START of every turn. Read-only w.r.t. your own files. Safe anytime.
#
#   bash research/bin/sync
#
# Mirrors what EVERY OTHER agent wrote into .research-sync/ (gitignored). One peer or three, same
# command. It never writes into research/ itself, so a stray `git add` can never commit another
# agent's files onto your branch.
#
# Peer discovery: every `arena/*` branch on origin that is not yours and carries `research/CHARTER.md`.
# Any single peer can be pinned with $OTHER_BRANCH or in .research-local; pinning is a hint, not a
# filter — sync always lists all peers it can see.
set -uo pipefail

# Env must beat the config file, otherwise a wrong config can never be corrected or tested.
ENV_SELF=${SELF:-}; ENV_SELF_BRANCH=${SELF_BRANCH:-}; ENV_OTHER_BRANCH=${OTHER_BRANCH:-}
[ -f .research-local ] && . ./.research-local
[ -n "$ENV_SELF" ] && SELF=$ENV_SELF
[ -n "$ENV_SELF_BRANCH" ] && SELF_BRANCH=$ENV_SELF_BRANCH
[ -n "$ENV_OTHER_BRANCH" ] && OTHER_BRANCH=$ENV_OTHER_BRANCH
SELF=${SELF:-agent-a}
SELF_BRANCH=${SELF_BRANCH:-$(git rev-parse --abbrev-ref HEAD)}

SYNC=.research-sync
mkdir -p "$SYNC"

echo "== $SELF ($SELF_BRANCH) =="

# Explicit refspec: a single-branch clone otherwise creates no origin/<branch> ref and every read
# below silently fails.
git fetch --quiet --force origin 'refs/heads/*:refs/remotes/origin/*' 2>/dev/null \
  || git fetch --quiet origin 2>/dev/null \
  || { echo "!! offline, cannot fetch"; exit 1; }

# ---- discover peers ----
PEERS=""
# A peer is ANY other branch carrying an inbox. Do not filter on the branch name: Arena allocates
# arena/<hash> per session, and a resumed session can land anywhere. The file is the identity.
for b in $(git for-each-ref --format='%(refname:short)' 'refs/remotes/origin/' 2>/dev/null \
           | sed 's#^origin/##'); do
  [ "$b" = "$SELF_BRANCH" ] && continue
  [ "$b" = "HEAD" ] && continue
  if git ls-tree -r --name-only "origin/$b" research/msg 2>/dev/null | grep -q 'inbox-agent-'; then
    PEERS="$PEERS $b"
  fi
done
PEERS=$(printf '%s\n' $PEERS)
if [ -z "$PEERS" ]; then
  echo "!! no peer branch found on origin carrying research/."
  echo "   If the other agent has not pushed yet, wait a turn."
  echo "   If their branch has a different name: echo 'OTHER_BRANCH=<branch>' >> .research-local"
  exit 1
fi
echo "peers: $(printf '%s ' $PEERS)"
echo

# ---- mirror every peer ----
for BR in $PEERS; do
  TAG=$(printf '%s' "$BR" | tr '/' '-')
  echo "---- from $BR ----"

  # outgoing messages from this peer
  for f in $(git ls-tree -r --name-only "origin/$BR" research/msg 2>/dev/null | grep 'inbox-'); do
    base=$(basename "$f")
    [ "$base" = "inbox-$SELF.md" ] && continue      # our own file, not a peer's
    git show "origin/$BR:$f" > "$SYNC/$base" 2>/dev/null \
      && echo "   read $f  ($(grep -c '^## MSG-' "$SYNC/$base" 2>/dev/null || echo 0) msgs)"
  done

  # their status (present tense)
  for f in $(git ls-tree -r --name-only "origin/$BR" research/log 2>/dev/null | grep 'status-agent-'); do
    base=$(basename "$f")
    [ "$base" = "status-agent-${SELF#agent-}.md" ] && continue
    git show "origin/$BR:$f" > "$SYNC/$base" 2>/dev/null && echo "   read $f"
  done

  # spec drift
  for f in research/CHARTER.md research/ROLES.md research/BOARD.md research/PROTOCOL.md; do
    if git show "origin/$BR:$f" > "$SYNC/${TAG}-$(basename "$f")" 2>/dev/null; then
      if [ -f "$f" ] && ! diff -q "$f" "$SYNC/${TAG}-$(basename "$f")" >/dev/null 2>&1; then
        printf '   ~ %s DIFFERS from this branch\n' "$f"
        echo "$f" >> "$SYNC/.spec-diffs"
      fi
    fi
  done
done

echo
echo "================ status of each peer ================"
for f in "$SYNC"/status-agent-*.md; do
  [ -e "$f" ] || continue
  echo; echo "### $(basename "$f" .md | sed 's/status-//')"
  head -12 "$f"
done

echo
echo "================ messages (headlines) ================"
for f in "$SYNC"/inbox-agent-*.md; do
  [ -e "$f" ] || continue
  echo; echo "### $(basename "$f" .md | sed 's/inbox-//')"
  grep -E '^## MSG-|^\*\*' "$f" 2>/dev/null | tail -20 || echo "(none)"
  echo "   full text: $f"
done

if [ -s "$SYNC/.spec-diffs" ]; then
  echo
  echo "================ SPEC DIFFERS ================"
  sort -u "$SYNC/.spec-diffs" | while read -r f; do
    echo "### $f"
    for m in "$SYNC"/*-"$(basename "$f")"; do
      [ -e "$m" ] || continue
      diff -u "$f" "$m" | head -30
    done
  done
  echo "   Adopt only if a ruling was recorded:  cp .research-sync/<peer>-<file> research/<file>"
fi
rm -f "$SYNC/.spec-diffs"

if [ "$SELF" = "agent-a" ]; then SENDARG=""; else SENDARG=${SELF#agent-}; fi
echo
echo "Next: read the messages above, then reply with"
echo "  bash research/bin/send $SENDARG \"subject\" body.md"
echo "Then refresh the board:  bash research/bin/board"
