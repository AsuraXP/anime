#!/usr/bin/env bash
# research/bin/sync — run at the START of every turn. Read-only w.r.t. your own files. Safe anytime.
#
#   bash research/bin/sync
#
# Mirrors what EVERY OTHER agent wrote into .research-sync/ (gitignored): inboxes, statuses,
# threads, graveyard entries, and bench files. It never writes into research/ itself, so a stray
# `git add` can never commit another agent's files onto your branch.
set -uo pipefail

ENV_SELF=${SELF:-}; ENV_SELF_BRANCH=${SELF_BRANCH:-}; ENV_OTHER_BRANCH=${OTHER_BRANCH:-}
[ -f .research-local ] && . ./.research-local
[ -n "$ENV_SELF" ] && SELF=$ENV_SELF
[ -n "$ENV_SELF_BRANCH" ] && SELF_BRANCH=$ENV_SELF_BRANCH
[ -n "$ENV_OTHER_BRANCH" ] && OTHER_BRANCH=$ENV_OTHER_BRANCH
SELF=${SELF:-agent-a}
SELF_BRANCH=${SELF_BRANCH:-$(git rev-parse --abbrev-ref HEAD)}

SYNC=.research-sync
mkdir -p "$SYNC" "$SYNC/threads" "$SYNC/graveyard" "$SYNC/bench"
rm -f "$SYNC/.spec-diffs"

echo "== $SELF ($SELF_BRANCH) =="

git fetch --quiet --force origin 'refs/heads/*:refs/remotes/origin/*' 2>/dev/null \
  || git fetch --quiet origin 2>/dev/null \
  || { echo "!! offline, cannot fetch"; exit 1; }

# If Arena resumed this sandbox from the base commit with a restored working tree while origin/$SELF_BRANCH
# already has our earlier commits, advance HEAD/index to origin/$SELF_BRANCH without touching working files.
if git show-ref --verify --quiet "refs/remotes/origin/$SELF_BRANCH"; then
  if [ "$(git rev-parse HEAD)" != "$(git rev-parse "origin/$SELF_BRANCH")" ] \
     && git merge-base --is-ancestor HEAD "origin/$SELF_BRANCH" 2>/dev/null; then
    git reset --mixed -q "origin/$SELF_BRANCH"
    echo "   (re-aligned local HEAD with origin/$SELF_BRANCH after sandbox resume)"
  fi
fi

# ---- discover active peer branches (one canonical branch per peer agent) ----
# If an agent's session moved to a new Arena branch, an older closed branch for that same agent may
# still exist on origin. Pick, for each agent != SELF, the branch whose inbox-agent-<x>.md has the
# most messages (ties broken by latest commit timestamp).
declare -A BEST_BR BEST_MSGS BEST_TS
for b in $(git for-each-ref --format='%(refname:short)' 'refs/remotes/origin/' 2>/dev/null \
           | sed 's#^origin/##'); do
  [ "$b" = "$SELF_BRANCH" ] && continue
  [ "$b" = "HEAD" ] && continue
  ts=$(git log -1 --format='%ct' "origin/$b" 2>/dev/null || echo 0)
  for f in $(git ls-tree -r --name-only "origin/$b" research/msg 2>/dev/null | grep 'inbox-agent-'); do
    who=$(basename "$f" .md | sed 's/^inbox-//')
    [ "$who" = "$SELF" ] && continue
    msgs=$(git show "origin/$b:$f" 2>/dev/null | grep -c '^## MSG-' || true)
    prev_msgs=${BEST_MSGS[$who]:--1}
    prev_ts=${BEST_TS[$who]:-0}
    if [ "$msgs" -gt "$prev_msgs" ] || { [ "$msgs" -eq "$prev_msgs" ] && [ "$ts" -gt "$prev_ts" ]; }; then
      BEST_BR[$who]="$b"
      BEST_MSGS[$who]="$msgs"
      BEST_TS[$who]="$ts"
    fi
  done
done

PEERS=""
for who in $(printf '%s\n' "${!BEST_BR[@]}" | sort); do
  [ -n "$who" ] || continue
  PEERS="$PEERS ${BEST_BR[$who]}"
done
PEERS=$(printf '%s\n' $PEERS)

if [ -z "$PEERS" ]; then
  echo "!! no peer branch found on origin carrying a peer inbox yet."
  echo "   If the other agents are still on turn 1, let them finish and push first."
  exit 1
fi
echo "peers: $(for who in $(printf '%s\n' "${!BEST_BR[@]}" | sort); do printf '%s=%s ' "$who" "${BEST_BR[$who]}"; done)"
echo

# ---- mirror every active peer ----
for who in $(printf '%s\n' "${!BEST_BR[@]}" | sort); do
  BR="${BEST_BR[$who]}"
  TAG=$(printf '%s' "$BR" | tr '/' '-')
  echo "---- from $who ($BR) ----"

  f="research/msg/inbox-$who.md"
  if git show "origin/$BR:$f" > "$SYNC/inbox-$who.md" 2>/dev/null; then
    echo "   read $f  ($(grep -c '^## MSG-' "$SYNC/inbox-$who.md" 2>/dev/null || true) msgs)"
  fi

  sf="research/log/status-$who.md"
  if git show "origin/$BR:$sf" > "$SYNC/status-$who.md" 2>/dev/null; then
    echo "   read $sf"
  fi

  # Mirror peer artifacts (threads, graveyard, bench) into .research-sync/<dir>/ so every seat can
  # read candidates, attacks, graveyard walls, and certified harnesses directly without git plumbing.
  for dir in threads graveyard bench; do
    for af in $(git ls-tree -r --name-only "origin/$BR" "research/$dir" 2>/dev/null); do
      base=$(basename "$af")
      [ "$base" = "README.md" ] && continue
      # Only mirror if missing locally or differs from our local copy
      if [ ! -f "$af" ] || ! git diff --quiet "origin/$BR:$af" -- "$af" 2>/dev/null; then
        git show "origin/$BR:$af" > "$SYNC/$dir/$base" 2>/dev/null \
          && echo "   mirrored $af -> $SYNC/$dir/$base"
      fi
    done
  done

  # Spec drift against STEWARD branch (only meaningful if Steward updated shared specs)
  if [ "$who" = "agent-a" ]; then
    for sp in research/CHARTER.md research/ROLES.md research/BOARD.md research/PROTOCOL.md research/bin/sync research/bin/send; do
      if git show "origin/$BR:$sp" > "$SYNC/${TAG}-$(basename "$sp")" 2>/dev/null; then
        if [ -f "$sp" ] && ! diff -q "$sp" "$SYNC/${TAG}-$(basename "$sp")" >/dev/null 2>&1; then
          printf '   ~ %s UPDATED on steward branch (%s)\n' "$sp" "$BR"
          echo "$sp:$SYNC/${TAG}-$(basename "$sp")" >> "$SYNC/.spec-diffs"
        fi
      fi
    done
  fi
done

echo
echo "================ status of each peer ================"
for f in "$SYNC"/status-agent-*.md; do
  [ -e "$f" ] || continue
  echo; echo "### $(basename "$f" .md | sed 's/status-//')"
  head -16 "$f"
done

echo
echo "================ messages (headlines) ================"
for f in "$SYNC"/inbox-agent-*.md; do
  [ -e "$f" ] || continue
  echo; echo "### $(basename "$f" .md | sed 's/inbox-//')"
  grep -E '^## MSG-|^\*\*' "$f" 2>/dev/null | tail -20 || echo "(none)"
  echo "   full text: $f"
done

echo
echo "================ mirrored peer artifacts ================"
find "$SYNC/threads" "$SYNC/graveyard" "$SYNC/bench" -type f 2>/dev/null | sort | sed 's/^/   /'

if [ -s "$SYNC/.spec-diffs" ]; then
  echo
  echo "================ STEWARD SPEC UPDATES ================"
  sort -u "$SYNC/.spec-diffs" | while IFS=: read -r sp mirror; do
    echo "   updated: $sp  (adopt with: cp $mirror $sp)"
  done
fi
rm -f "$SYNC/.spec-diffs"

if [ "$SELF" = "agent-a" ]; then SENDARG=""; else SENDARG=${SELF#agent-}; fi
echo
echo "Next: read the messages above, then reply with"
echo "  bash research/bin/send $SENDARG \"subject\" body.md"
