#!/usr/bin/env bash
# research/bin/send — run at the END of every turn.
#
#   bash research/bin/send   "subject" body.md            # agent-a
#   bash research/bin/send b "subject" body.md            # agent-b
#   bash research/bin/send b "subject" body.md research/threads/0002-foo-agent-b.md   # extra files
#
# Appends a message to YOUR OWN inbox (the one file only you ever write), commits ONLY files you
# own, pushes ONLY your branch, and VERIFIES the message actually made it into the commit.
#
# HARD OWNERSHIP GUARD. Before committing, every staged path is checked against an allowlist:
#     research/msg/inbox-<you>.md
#     research/log/decisions-<you>.md
#     research/log/status-<you>.md
#     anything passed explicitly on the command line
# Anything else aborts the commit. This exists because two variants of this script shipped bugs that
# silently put the wrong files on the wrong branch (D-010, D-012). The guard is cheaper than trust.
set -uo pipefail

[ -f .research-local ] && . ./.research-local
SELF=${SELF:-agent-a}
if [ "${1:-}" = "b" ]; then SELF=agent-b; shift; fi
BRANCH=${BRANCH:-${SELF_BRANCH:-$(git rev-parse --abbrev-ref HEAD)}}

SUBJECT="${1:-}"; BODY_FILE="${2:-}"; shift 2 2>/dev/null || true
EXTRA=("$@")
[ -z "$SUBJECT" ] && { echo "usage: send [b] \"<subject>\" [body.md] [extra files...]"; exit 2; }

INBOX="research/msg/inbox-$SELF.md"
mkdir -p research/msg
[ -f "$INBOX" ] || printf '# inbox — %s\nOUTGOING messages from %s. The other agent reads this file; it never writes it.\nAppend-only. A correction is a new message, never an edit.\n' "$SELF" "$SELF" > "$INBOX"

N=$(grep -c '^## MSG-' "$INBOX" 2>/dev/null) || N=0
N=$((N + 1))
ID=$(printf 'MSG-%04d' "$N")

{
  echo
  echo "## $ID · $(date -u +%Y-%m-%dT%H:%M:%SZ) · [$SELF]"
  echo "**$SUBJECT**"
  echo
  if [ -n "$BODY_FILE" ] && [ -f "$BODY_FILE" ]; then cat "$BODY_FILE"; fi
} >> "$INBOX"
echo "appended $ID to $INBOX"

# ---- owned paths only, and only those that exist ----
ALLOW=("$INBOX" "research/log/decisions-$SELF.md" "research/log/status-$SELF.md")
PATHS=()
for p in "${ALLOW[@]}"; do [ -e "$p" ] && PATHS+=("$p"); done
for p in ${EXTRA[@]+"${EXTRA[@]}"}; do
  [ -e "$p" ] || { echo "!! extra path does not exist: $p"; exit 1; }
  PATHS+=("$p")
done

# Stage our own paths first: `git commit -- <path>` requires the path to exist in the index, so a
# brand-new inbox file must be added before it can be committed by pathspec.
git add -- "${PATHS[@]}" || { echo "!! git add failed"; exit 1; }

# ---- HARD OWNERSHIP GUARD ----
# Every path we are about to commit must be on the allowlist. Checked directly against PATHS, so the
# index's pre-existing contents are irrelevant: whatever someone else staged, this command cannot
# commit it, because we commit explicit paths below rather than "everything in the index".
# History: variant 1 staged nothing when a log file was missing (message lost, exit 0);
#          variant 2 swept bootstrap-seeded spec files onto the peer's branch;
#          variant 3 refused whenever the tree had unrelated staged changes;
#          variant 4 let an unrelated staged file into the commit.
# Each of those was a silent write to the wrong place, so the guard is now structural, not advisory.
VIOLATIONS=""
for p in "${PATHS[@]}"; do
  ok=0
  for a in "${ALLOW[@]}" ${EXTRA[@]+"${EXTRA[@]}"}; do [ "$p" = "$a" ] && ok=1 && break; done
  [ "$ok" = "0" ] && VIOLATIONS="$VIOLATIONS $p"
done
if [ -n "$VIOLATIONS" ]; then
  echo "!! REFUSING TO COMMIT: paths outside your ownership:$VIOLATIONS"
  exit 1
fi

if git diff --quiet -- "${PATHS[@]}" && [ -z "$(git ls-files --others --exclude-standard -- "${PATHS[@]}")" ]; then
  echo "nothing to commit — message not delivered"; exit 1
fi

# Commit explicit paths only. `git commit -- <paths>` ignores the rest of the index, so unrelated
# staged work can never ride along.
git -c user.name="$SELF" -c user.email="$SELF@users.noreply.github.com" \
    commit -q -m "msg: $ID from $SELF — $SUBJECT" -- "${PATHS[@]}" \
  || { echo "!! commit failed"; exit 1; }

if ! git show --name-only --format='' HEAD | grep -qx "$INBOX"; then
  echo "!! FAIL: $INBOX not in commit $(git rev-parse --short HEAD)"; exit 1
fi

if git push --quiet origin "$BRANCH"; then
  echo "pushed $ID to $BRANCH ($(git rev-parse --short HEAD))"
  echo "  committed: $(git show --name-only --format='' HEAD | tr '\n' ' ')"
else
  echo "!! push failed — committed locally but NOT visible to the other agent"; exit 1
fi
