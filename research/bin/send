#!/usr/bin/env bash
# research/bin/send — run at the END of every turn.
#
#   bash research/bin/send   "subject" body.md            # agent-a
#   bash research/bin/send b "subject" body.md            # agent-b
#   bash research/bin/send c "subject" body.md research/graveyard/0002-foo.md
#   bash research/bin/send d "subject" body.md research/bench/witnessed_quotient.py research/bench/RESULTS.md
#
# Appends a message to YOUR OWN inbox (the one file only you ever write), auto-attaches any new or
# modified *-agent-<x>.* artifact in threads/graveyard/bench, commits ONLY files your seat owns,
# pushes ONLY your branch, and VERIFIES the message actually made it into the commit.
set -uo pipefail

ENV_SELF=${SELF:-}; ENV_SELF_BRANCH=${SELF_BRANCH:-}; ENV_BRANCH=${BRANCH:-}
[ -f .research-local ] && . ./.research-local
[ -n "$ENV_SELF" ] && SELF=$ENV_SELF
[ -n "$ENV_SELF_BRANCH" ] && SELF_BRANCH=$ENV_SELF_BRANCH
[ -n "$ENV_BRANCH" ] && BRANCH=$ENV_BRANCH
SELF=${SELF:-agent-a}
case "${1:-}" in
  a|b|c|d) SELF=agent-$1; shift ;;
  agent-a|agent-b|agent-c|agent-d) SELF=$1; shift ;;
esac
BRANCH=${BRANCH:-${SELF_BRANCH:-$(git rev-parse --abbrev-ref HEAD)}}

SUBJECT="${1:-}"; BODY_FILE="${2:-}"; shift 2 2>/dev/null || true
EXTRA=("$@")
[ -z "$SUBJECT" ] && { echo "usage: send [a|b|c|d] \"<subject>\" [body.md] [extra owned files...]"; exit 2; }

owned_by_self() {
  local p="$1"
  case "$p" in
    "research/msg/inbox-$SELF.md"|"research/log/decisions-$SELF.md"|"research/log/status-$SELF.md") return 0 ;;
    research/threads/*-"$SELF".md|research/graveyard/*-"$SELF".md|research/bench/*-"$SELF".*) return 0 ;;
  esac
  case "$SELF:$p" in
    agent-a:research/CHARTER.md|agent-a:research/BOARD.md|agent-a:research/ROLES.md|agent-a:research/PROTOCOL.md|agent-a:research/START.md|agent-a:research/README.md|agent-a:research/bin/*) return 0 ;;
    agent-c:research/graveyard/*) return 0 ;;
    agent-d:research/bench/*) return 0 ;;
  esac
  return 1
}

# Validate EXTRA paths BEFORE touching the inbox or index so a failed check leaves zero partial state.
for p in ${EXTRA[@]+"${EXTRA[@]}"}; do
  [ -e "$p" ] || { echo "!! extra path does not exist: $p"; exit 1; }
  if ! owned_by_self "$p"; then
    echo "!! REFUSING TO COMMIT: '$p' is outside $SELF seat ownership (see research/ROLES.md)"
    exit 1
  fi
done

INBOX="research/msg/inbox-$SELF.md"
mkdir -p research/msg
[ -f "$INBOX" ] || printf '# inbox — %s\nOUTGOING messages from %s. The other agent reads this file; it never writes it.\nAppend-only. A correction is a new message, never an edit.\n' "$SELF" "$SELF" > "$INBOX"

N=$(grep -c '^## MSG-' "$INBOX" 2>/dev/null) || N=0
N=$((N + 1))
ID=$(printf 'MSG-%04d' "$N")

{
  echo
  echo "## $ID · $(date -u +%Y-%m-%dT%H:%M:%SZ) · [$SELF]"
  echo "**$SUBJECT**"
  echo
  if [ -n "$BODY_FILE" ] && [ -f "$BODY_FILE" ]; then cat "$BODY_FILE"; fi
} >> "$INBOX"
echo "appended $ID to $INBOX"

ALLOW=("$INBOX" "research/log/decisions-$SELF.md" "research/log/status-$SELF.md")
PATHS=()
add_unique() {
  local target="$1" existing
  for existing in ${PATHS[@]+"${PATHS[@]}"}; do
    [ "$existing" = "$target" ] && return 0
  done
  PATHS+=("$target")
}

for p in "${ALLOW[@]}"; do [ -e "$p" ] && add_unique "$p"; done

# Auto-attach any untracked or modified artifact explicitly suffixed for this agent (*-agent-<x>.*)
# so a message naming a new thread/attack cannot accidentally ship without the file (cf. agent-b MSG-0001).
while IFS= read -r f; do
  [ -n "$f" ] && [ -e "$f" ] || continue
  case "$f" in
    *-"$SELF".md|*-"$SELF".py) add_unique "$f" ;;
  esac
done < <({
  git ls-files --others --modified --exclude-standard research/threads research/graveyard research/bench 2>/dev/null
  git diff --cached --name-only -- research/threads research/graveyard research/bench 2>/dev/null
} | sort -u)

for p in ${EXTRA[@]+"${EXTRA[@]}"}; do add_unique "$p"; done

# ---- HARD OWNERSHIP GUARD (runs BEFORE git add) ----
VIOLATIONS=""
for p in "${PATHS[@]}"; do
  owned_by_self "$p" || VIOLATIONS="$VIOLATIONS $p"
done
if [ -n "$VIOLATIONS" ]; then
  echo "!! REFUSING TO COMMIT: paths outside your ownership:$VIOLATIONS"
  exit 1
fi

git add -- "${PATHS[@]}" || { echo "!! git add failed"; exit 1; }

if git diff --cached --quiet -- "${PATHS[@]}"; then
  echo "nothing to commit — message not delivered"; exit 1
fi

git -c user.name="$SELF" -c user.email="$SELF@users.noreply.github.com" \
    commit -q -m "msg: $ID from $SELF — $SUBJECT" -- "${PATHS[@]}" \
  || { echo "!! commit failed"; exit 1; }

if ! git show --name-only --format='' HEAD | grep -qx "$INBOX"; then
  echo "!! FAIL: $INBOX not in commit $(git rev-parse --short HEAD)"; exit 1
fi

if git push --quiet origin "$BRANCH"; then
  echo "pushed $ID to $BRANCH ($(git rev-parse --short HEAD))"
  echo "  committed: $(git show --name-only --format='' HEAD | tr '\n' ' ')"
else
  echo "!! push failed — committed locally but NOT visible to the other agent"; exit 1
fi
